enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  CHAT
  VOICE
  MANUAL
}

enum RecommendationStatus {
  ACTIVE
  DISMISSED
  APPLIED
}

enum AlertType {
  COST_INCREASE
  LOW_MARGIN
  CASH_FLOW
}

enum MessageRole {
  USER
  ASSISTANT
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  businessType    String
  targetMarginPct Float    @default(40)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categories       Category[]
  transactions     Transaction[]
  monthlySummaries MonthlySummary[]
  recommendations  Recommendation[]
  alerts           Alert[]
  agentMessages    AgentMessage[]

  @@map("users")
}

model Category {
  id     String       @id @default(uuid())
  userId String
  name   String
  type   CategoryType
  color  String       @default("#3B82F6")
  icon   String       @default("tag")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  monthlySummaries MonthlySummary[]
  recommendations  Recommendation[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id         String            @id @default(uuid())
  userId     String
  categoryId String
  type       TransactionType
  amount     Float
  note       String?
  date       DateTime          @default(now())
  source     TransactionSource @default(MANUAL)
  rawText    String?
  createdAt  DateTime          @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([categoryId, date])
  @@index([userId, type, date], name:"idx_tx_user_type_date")
  @@map("transactions")
}

model MonthlySummary {
  id               Int    @id @default(autoincrement())
  userId           String
  categoryId       String
  year             Int
  month            Int
  totalAmount      Float
  transactionCount Int
  avgAmount        Float

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, year, month])
  @@index([year, month], name: "idx_monthly_year_month")
  @@map("monthly_summaries")
}

model Recommendation {
  id             String               @id @default(uuid())
  userId         String
  categoryId     String
  title          String
  description    String
  suggestedPrice Float
  currentPrice   Float
  variationPct   Float
  status         RecommendationStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, status])
  @@map("recommendations")
}

model Alert {
  id        String    @id @default(uuid())
  userId    String
  message   String
  type      AlertType
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead], name: "idx_alerts_unread")
  @@map("alerts")
}

model AgentMessage {
  id        String      @id @default(uuid())
  userId    String
  role      MessageRole
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("agent_messages")
}
