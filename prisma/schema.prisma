generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  businessType    String   @default("restaurant")
  targetMarginPct Float    @default(40)
  createdAt       DateTime @default(now())

  categories    Category[]
  transactions  Transaction[]
  recommendations Recommendation[]
  alerts        Alert[]
  agentMessages AgentMessage[]

  @@map("users")
}

model Category {
  id     String @id @default(uuid())
  userId String
  name   String
  type   String // INCOME | EXPENSE
  color  String @default("#6366f1")
  icon   String @default("tag")

  user            User            @relation(fields: [userId], references: [id])
  transactions    Transaction[]
  recommendations Recommendation[]

  @@map("categories")
}

model Transaction {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  type       String   // INCOME | EXPENSE
  amount     Float
  note       String?
  date       DateTime @default(now())
  source     String   @default("MANUAL") // MANUAL | VOICE | CHAT
  rawText    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@map("transactions")
}

model Recommendation {
  id            String   @id @default(uuid())
  userId        String
  categoryId    String
  title         String
  description   String
  suggestedPrice Float
  currentPrice  Float
  variationPct  Float
  status        String   @default("ACTIVE") // ACTIVE | APPLIED | DISMISSED
  createdAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@map("recommendations")
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  message   String
  type      String   // COST_INCREASE | LOW_MARGIN | CASH_FLOW
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("alerts")
}

model AgentMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String   // USER | ASSISTANT
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("agent_messages")
}
